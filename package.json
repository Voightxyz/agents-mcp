{
  "name": "@voightxyz/agents-mcp",
  "version": "0.2.0",
  "description": "MCP server for Voight Agents: deploy, operate and orchestrate your AI agents from any MCP client.",
  "mcpName": "xyz.voight/agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "voight",
    "ai-agents",
    "agents",
    "claude",
    "cursor",
    "codex"
  ],
  "homepage": "https://voight.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voightxyz/agents-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/voightxyz/agents-mcp/issues"
  },
  "license": "Apache-2.0",
  "author": "Voight (https://voight.xyz)",
  "type": "module",
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/notices.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
